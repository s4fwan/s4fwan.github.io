# --- Text files: Normalize line endings to LF, mark as text, keep trailing newline
*.html              text eol=lf eof=lf
*.css               text eol=lf eof=lf
*.js                text eol=lf eof=lf
*.json              text eol=lf
*.xml               text eol=lf
*.svg               text eol=lf
*.md                text eol=lf
*.webmanifest       text eol=lf
LICENSE             text eol=lf
CNAME               text eol=lf

# --- Treat all files not listed as binary by default (fallback)
*                   text=auto

# --- Binary files: Don't modify or diff
*.png               binary
*.ico               binary

# --- Lock config files to LF only
.gitattributes      text eol=lf
.gitignore          text eol=lf
